#!/usr/bin/env python3
"""Launch the Sulde KB CLI without a shell dependency."""

from __future__ import annotations

import os
from pathlib import Path
import runpy
import subprocess
import sys
from types import SimpleNamespace
from typing import Sequence


REPO_ROOT = Path(__file__).resolve().parents[2]
kb_cli = SimpleNamespace(
    **runpy.run_path(str(REPO_ROOT / "hooks" / "lib" / "kb_cli.py"))
)


def kb_home_text() -> str:
    configured = os.environ.get("SULDE_KB_HOME")
    if configured:
        return configured
    return str(Path.home() / ".sulde" / "data" / "kb")


def main(arguments: Sequence[str] | None = None) -> int:
    args = list(sys.argv[1:] if arguments is None else arguments)
    home_text = kb_home_text()
    if args and args[0] == "home":
        print(home_text)
        return 0

    home = Path(home_text)
    python = kb_cli.resolve_venv_python(home, require_executable=True)
    if python is None:
        print(
            f"kb-index venv not found under: {home / 'venv'} "
            "(tried bin/python, Scripts/python.exe)",
            file=sys.stderr,
        )
        return 2

    if not args:
        commands = "|".join(kb_cli.command_names())
        print(f"usage: kb-index {{home|{commands}}} [args...]", file=sys.stderr)
        return 2

    subcommand, *command_arguments = args
    try:
        command = kb_cli.build_command(
            REPO_ROOT,
            home,
            subcommand,
            command_arguments,
            python=python,
        )
    except ValueError:
        print(f"unknown command: {subcommand}", file=sys.stderr)
        return 2

    environment = os.environ.copy()
    environment["SULDE_KB_HOME"] = str(home)
    environment["PYTHONIOENCODING"] = "utf-8"
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    try:
        if os.name != "nt":
            os.execve(str(python), command, environment)
            return 0
        completed = subprocess.run(command, env=environment, check=False)
        return completed.returncode
    except OSError as error:
        print(
            f"kb-index: failed to launch {command[1]}: {error}",
            file=sys.stderr,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
