#!/usr/bin/env python3
"""Launch the Sulde KB MCP server without a shell dependency."""

from __future__ import annotations

import os
from pathlib import Path
import runpy
import subprocess
import sys
from types import SimpleNamespace
from typing import Sequence


REPO_ROOT = Path(__file__).resolve().parents[2]
kb_cli = SimpleNamespace(
    **runpy.run_path(str(REPO_ROOT / "hooks" / "lib" / "kb_cli.py"))
)


def kb_home_text() -> str:
    configured = os.environ.get("SULDE_KB_HOME")
    if configured:
        return configured
    return str(Path.home() / ".sulde" / "data" / "kb")


def main(arguments: Sequence[str] | None = None) -> int:
    args = list(sys.argv[1:] if arguments is None else arguments)
    home_text = kb_home_text()
    if args and args[0] == "--print-home":
        print(home_text)
        return 0

    home = Path(home_text)
    python = kb_cli.resolve_venv_python(home, require_executable=True)
    if python is None:
        print(
            f"sulde-kb-mcp: venv Python not found under {home / 'venv'} "
            "(tried bin/python, Scripts/python.exe)",
            file=sys.stderr,
        )
        return 2

    environment = os.environ.copy()
    environment["SULDE_KB_HOME"] = str(home)
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    if args and args[0] == "--status":
        target = REPO_ROOT / "scripts" / "kb" / "sulde-status.py"
        target_arguments = ["--json"]
    else:
        target = REPO_ROOT / "tools" / "kb-mcp" / "server.py"
        target_arguments = []
        environment["PYTHONUNBUFFERED"] = "1"

    command = [str(python), str(target), *target_arguments]
    try:
        if os.name != "nt":
            os.execve(str(python), command, environment)
            return 0
        completed = subprocess.run(command, env=environment, check=False)
        return completed.returncode
    except OSError as error:
        print(f"sulde-kb-mcp: failed to launch {target}: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
