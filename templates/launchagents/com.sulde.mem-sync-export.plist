<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sulde.mem-sync-export</string>
    <key>Program</key>
    <string>/usr/bin/python3</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__SULDE_SOURCE_ROOT__/scripts/kb/mem-sync.py</string>
        <string>export</string>
        <string>--scheduled</string>
    </array>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SULDE_KB_HOME</key>
        <string>__SULDE_KB_HOME__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__SULDE_KB_HOME__/mem-sync-export.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__SULDE_KB_HOME__/mem-sync-export.stderr.log</string>
</dict>
</plist>
