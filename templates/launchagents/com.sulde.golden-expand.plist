<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 每周日 11:00：接 10:30 周委员会之后，使用当周召回数据扩充候选。 -->
    <key>Label</key>
    <string>com.sulde.golden-expand</string>
    <key>Program</key>
    <string>/usr/bin/python3</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__SULDE_SOURCE_ROOT__/scripts/kb/golden-expand.py</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__SULDE_USER_BIN__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SULDE_KB_HOME</key>
        <string>__SULDE_KB_HOME__</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__SULDE_KB_HOME__/golden-expand.log</string>
    <key>StandardErrorPath</key>
    <string>__SULDE_KB_HOME__/golden-expand.log</string>
</dict>
</plist>
