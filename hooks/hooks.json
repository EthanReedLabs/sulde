{
  "description": "Sulde v0.8.0 workspace intent supervision plus opt-in mobile engineering enforcement, Python-based for cross-OS support. Intent shadow state is workspace-scoped; project gates use .sulde-config.yaml.",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" notification.py",
            "shell": "bash",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" post_tool_use.py",
            "shell": "bash",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" post_tool_use.py",
            "shell": "bash",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" pre_compact.py",
            "shell": "bash",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" pre_tool_use.py",
            "shell": "bash",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" canon_inject.py",
            "shell": "bash",
            "type": "command"
          },
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" session_start.py",
            "shell": "bash",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" stop.py",
            "shell": "bash",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.sh\" user_prompt_submit.py",
            "shell": "bash",
            "type": "command"
          }
        ]
      }
    ]
  }
}
