# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Logs / tmp
*.log
.tmp/

# Python
__pycache__/
*.pyc
*.pyo

# Local secrets (just in case — sulde-cc itself has none, but defends against future drift)
.env
.env.local
*.local

# AI workspace — handoffs / drafts / 接力文档, never committed
/.ai-workspace/

# codex delegation workflow state (local only)
/.codex-agent/
/.worktrees/
# KB local hybrid index (derived, per-machine)
/.kb-index/
.claude/settings.local.json

# Private, reproducible control-composition test evidence
/.sulde/data/guardian-control-composition/

# Private public-release review payloads and provenance (never publish these).
/.sulde/public-export/
