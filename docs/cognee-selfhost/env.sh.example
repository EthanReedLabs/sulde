# Cognee 客户端配置模板 (Mac/Linux)
# 真实文件位置:~/.config/cognee/env.sh (chmod 600),由 ~/.zshrc 中一行加载:
#   [ -f ~/.config/cognee/env.sh ] && source ~/.config/cognee/env.sh
# 本模板 key 为占位符,勿在仓库中存真实 key。

# ── 远程模式(A1 server 部署完成后启用;设了 COGNEE_BASE_URL 插件即走远程) ──
# export COGNEE_BASE_URL="http://<A1固定IP>:8000"

# ── 本地模式配置(远程模式下客户端不用,保留作断网回退) ──
export COGNEE_GLM_KEY="<你的智谱 API key>"
export LLM_API_KEY="${COGNEE_GLM_KEY:-$CLAUDE_GLM_KEY}"
export LLM_PROVIDER="custom"
export LLM_MODEL="openai/glm-4.5-flash"
export LLM_ENDPOINT="https://open.bigmodel.cn/api/paas/v4"

# 嵌入:本地 fastembed,无需 API
export EMBEDDING_PROVIDER="fastembed"
export EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
export EMBEDDING_DIMENSIONS="384"
export EMBEDDING_MAX_TOKENS="256"
