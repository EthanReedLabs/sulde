    "test_patch": "diff --git a/tests/test_control_composition_architecture.py b/tests/test_control_composition_architecture.py\nindex 5f6f77f..1f9f37e 100644\n--- a/tests/test_control_composition_architecture.py\n+++ b/tests/test_control_composition_architecture.py\n@@ -20,7 +20,8 @@ from intent_guardian_parts import control_composition as composition, resources\n \n \n def baseline(name):\n-    return subprocess.check_output(['git', 'show', BASE+':scripts/kb/intent_guardian_parts/'+name+'.py'], cwd=ROOT, text=True)\n+    return subprocess.check_output(['git', 'show', BASE+':scripts/kb/intent_guardian_parts/'+name+'.py'],\n+        cwd=ROOT, text=True, encoding=\"utf-8\", errors=\"replace\")\n \n \n class WithoutImports(ast.NodeTransformer):\n@@ -114,7 +115,8 @@ class CompositionArchitectureTests(unittest.TestCase):\n                 code = \"import sys,importlib; sys.path.insert(0,'scripts/kb'); \" + '; '.join(\n                     \"importlib.import_module('intent_guardian_parts.\"+name+\"')\" for name in order)\n                 result = subprocess.run([sys.executable, '-B', '-c', code], cwd=ROOT,\n-                    env={**os.environ, 'PYTHONDONTWRITEBYTECODE':'1'}, capture_output=True, text=True, timeout=30)\n+                    env={**os.environ, 'PYTHONDONTWRITEBYTECODE':'1'}, capture_output=True, text=True,\n+                    encoding=\"utf-8\", errors=\"replace\", timeout=30)\n                 self.assertEqual(result.returncode, 0, result.stderr)\n \n     def test_policy_implementation_ast_is_unchanged(self):\ndiff --git a/tests/test_native_receipt_consistency.py b/tests/test_native_receipt_consistency.py\nindex 483667f..2c87b45 100644\n--- a/tests/test_native_receipt_consistency.py\n+++ b/tests/test_native_receipt_consistency.py\n@@ -131,6 +131,7 @@ class NativeReceiptConsistencyTests(unittest.TestCase):\n             child = subprocess.Popen(\n                 [sys.executable, \"-c\", WRITER, self.kb, str(self.path)],\n                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n+                encoding=\"utf-8\", errors=\"replace\",\n             )\n             self.children.append(child)\n             processes.append(child)\n@@ -177,6 +178,7 @@ class NativeReceiptConsistencyTests(unittest.TestCase):\n         return subprocess.Popen(\n             [sys.executable, \"-c\", RECOVER, self.kb, str(self.path)],\n             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n+            encoding=\"utf-8\", errors=\"replace\",\n         )\n \n     def test_fresh_process_recovers_after_effect_without_second_decision(self):\ndiff --git a/tests/test_selected_task_continuation.py b/tests/test_selected_task_continuation.py\nindex 1bc8903..4931a6e 100644\n--- a/tests/test_selected_task_continuation.py\n+++ b/tests/test_selected_task_continuation.py\n@@ -186,7 +186,7 @@ class SelectedTaskTests(unittest.TestCase):\n         result = subprocess.run(\n             [sys.executable, \"-B\", \"-c\", LOCK_PROBE, str(fixtures.SCRIPT_DIR),\n              *(str(path) for path in paths)],\n-            capture_output=True, text=True, timeout=15,\n+            capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", timeout=15,\n         )\n         self.assertEqual(result.returncode, 0, result.stderr)\n         return json.loads(result.stdout)\n"
